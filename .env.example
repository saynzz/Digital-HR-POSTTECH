# Скопируйте в .env: cp .env.example .env
# Реальные секреты в репозиторий не коммитим (.env в .gitignore).

POSTGRES_PASSWORD=janamen
JWT_SECRET=change-me-in-production
SEED_PASSWORD=demo123

# --- AI Jana / локальная LLM ---
# Профиль "ai" поднимает Ollama в Docker и скачивает модель. Пусто — без контейнера Ollama.
COMPOSE_PROFILES=ai
# ollama — генерация ответов локальной моделью; none — только цитаты из базы знаний
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://ollama:11434

# Режим «Ollama на хосте» (быстрее на Mac — использует GPU Apple Silicon):
#   1) brew install ollama && ollama serve && ollama pull qwen2.5:3b
#   2) раскомментируйте две строки ниже
# COMPOSE_PROFILES=
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Почта: приглашения сотрудникам ---
# auto — отправлять через SMTP, если заполнены SMTP_USER и SMTP_PASSWORD; smtp — всегда; mock — не отправлять
MAIL_PROVIDER=auto
# Gmail: включите двухэтапную аутентификацию и создайте пароль приложения
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=JanaMen · Jana Post
# Показывать HR ссылку-приглашение в интерфейсе (для демо). В проде: false
EXPOSE_INVITE_LINKS=true

# Адрес, который откроется по ссылке из письма.
# Чтобы открыть письмо на телефоне, укажите IP Mac в Wi-Fi: http://192.168.x.x:5173
DEV_APP_BASE_URL=http://localhost:5173
